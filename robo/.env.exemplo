# Copie este arquivo para ".env" e preencha. O ".env" fica só no seu computador
# e nunca vai para o GitHub.

# Usuário robô do Produtividade (perfil admin)
PROD_EMAIL=robo@vulcabras.com
PROD_SENHA=

# Pasta onde o WMS salva os downloads (troque SEU_USUARIO)
PASTA=C:\Users\SEU_USUARIO\Downloads

# Depois de enviar, move o arquivo para a subpasta "telao-enviados" (sim/nao)
MOVER_ENVIADOS=sim
