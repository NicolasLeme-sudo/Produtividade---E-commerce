# Copie este arquivo para ".env" e preencha. O ".env" fica só no seu computador
# e nunca vai para o GitHub.

# Usuário robô do Produtividade (perfil admin)
PROD_EMAIL=robo@vulcabras.com
PROD_SENHA=

# Pasta onde o WMS salva os downloads (troque SEU_USUARIO)
PASTA=C:\Users\SEU_USUARIO\Downloads

# Depois de enviar, move o arquivo para a subpasta "telao-enviados" (sim/nao)
MOVER_ENVIADOS=sim

# Mostra na tela o Google Chrome do robô baixando os relatórios (sim/nao).
# "nao" roda escondido (melhor no dia da Black, para não cobrir o telão).
MOSTRAR_NAVEGADOR=sim

# Usuário e senha do WMS. Preenchidos = o robô também BAIXA os relatórios sozinho
# (6 abas do WMS no Google Chrome; rápidos a cada 5 min, lentos a cada 10 min).
WMS_USUARIO=
WMS_SENHA=
